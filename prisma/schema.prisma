// CRM database schema. SQLite today; written to be PostgreSQL-compatible.
// No enums (string fields + Zod validation), no arrays (join tables).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  industry  String   @default("")
  website   String   @default("")
  phone     String   @default("")
  address   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  companies           Company[]
  contacts            Contact[]
  leads               Lead[]
  pipelines           Pipeline[]
  deals               Deal[]
  tasks               Task[]
  activities          Activity[]
  notes               Note[]
  notifications       Notification[]
  tags                Tag[]
  quotations          Quotation[]         @relation("QuotationOrganization")
  salesOrders         SalesOrder[]        @relation("SalesOrderOrganization")
  products            Product[]           @relation("ProductOrganization")
  leadSources         LeadSource[]
  emailTemplates      EmailTemplate[]
  customFields        CustomField[]
  emailSettings       EmailSettings?
  sentEmails          SentEmail[]
  inboundEmails       InboundEmail[]
  reminders           FollowUpReminder[]
  attachments         Attachment[]
  apiKeys             ApiKey[]
  sequences           Sequence[]
  sequenceEnrollments SequenceEnrollment[]
  sequenceDeadLetters SequenceDeadLetter[]
  lostReasons         LostReason[]
  priceLists          PriceList[]
  teams               Team[]
  currency            String               @default("USD")
  campaigns           Campaign[]
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]

  @@index([organizationId])
  @@index([name])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("MEMBER") // MEMBER | LEAD
  createdAt DateTime @default(now())

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([userId])
  @@unique([teamId, userId])
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  name           String
  passwordHash   String
  role           String    @default("SALES_REP") // ADMIN | MANAGER | SALES_REP
  title          String    @default("")
  phone          String    @default("")
  avatarColor    String    @default("#6366f1")
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamMemberships     TeamMember[]
  sessions            Session[]
  ownedCompanies      Company[]            @relation("CompanyOwner")
  ownedContacts       Contact[]            @relation("ContactOwner")
  ownedLeads          Lead[]               @relation("LeadOwner")
  assignedLeads       Lead[]               @relation("LeadAssignee")
  ownedDeals          Deal[]               @relation("DealOwner")
  stageHistoryEntries StageHistory[]
  tasks               Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  activities          Activity[]
  notes               Note[]
  attachments         Attachment[]
  notifications       Notification[]
  sentEmails          SentEmail[]          @relation("SentEmailSender")
  reminders           FollowUpReminder[]   @relation("ReminderRecipient")
  createdApiKeys      ApiKey[]             @relation("ApiKeyCreator")
  createdSequences    Sequence[]           @relation("SequenceCreator")
  sequenceEnrollments SequenceEnrollment[] @relation("SequenceEnrollmentResponder")

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  domain         String    @default("")
  industry       String    @default("")
  size           String    @default("")
  phone          String    @default("")
  website        String    @default("")
  address        String    @default("")
  city           String    @default("")
  state          String    @default("")
  country        String    @default("")
  ownerId        String?
  summary        String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     Contact[]
  leads        Lead[]
  deals        Deal[]
  quotations   Quotation[]   @relation("QuotationCompany")
  salesOrders  SalesOrder[]  @relation("SalesOrderCompany")
  activities   Activity[]
  notes        Note[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, name])
}

model Contact {
  id              String    @id @default(cuid())
  organizationId  String
  companyId       String?
  firstName       String
  lastName        String
  email           String
  phone           String    @default("")
  mobile          String    @default("")
  title           String    @default("")
  address         String    @default("")
  city            String    @default("")
  state           String    @default("")
  country         String    @default("")
  ownerId         String?
  status          String    @default("ACTIVE") // LEAD | ACTIVE | CUSTOMER | INACTIVE | CHURNED
  avatarColor     String    @default("#6366f1")
  summary         String    @default("")
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner               User?                @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  leads               Lead[]
  activities          Activity[]
  notes               Note[]
  deals               Deal[]               @relation("DealContact")
  quotations          Quotation[]          @relation("QuotationContact")
  salesOrders         SalesOrder[]         @relation("SalesOrderContact")
  sentEmails          SentEmail[]          @relation("SentEmailContact")
  inboundEmails       InboundEmail[]
  sequenceEnrollments SequenceEnrollment[] @relation("SequenceEnrollmentContact")
  campaignMembers     CampaignMember[]

  tags Tag[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, email])
  @@index([organizationId, companyId])
  @@index([organizationId, createdAt])
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#6366f1")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]

  @@unique([organizationId, name])
}

model LeadSource {
  id             String   @id @default(cuid())
  name           String
  description    String   @default("")
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]
  deals        Deal[]

  @@unique([organizationId, name])
}

model Lead {
  id                String    @id @default(cuid())
  organizationId    String
  firstName         String
  lastName          String
  email             String
  phone             String    @default("")
  companyName       String    @default("")
  companyId         String?
  sourceId          String?
  status            String    @default("NEW") // NEW | CONTACTED | QUALIFIED | UNQUALIFIED | CONVERTED
  score             Int       @default(0)
  estimatedValue    Float     @default(0)
  expectedCloseDate DateTime?
  followUpAt        DateTime?
  summary           String    @default("")
  contactId         String?
  assignedUserId    String?
  ownerId           String?
  convertedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  source              LeadSource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  contact             Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedUser        User?                @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  owner               User?                @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities          Activity[]
  notes               Note[]
  deals               Deal[]               @relation("DealLead")
  sentEmails          SentEmail[]          @relation("SentEmailLead")
  inboundEmails       InboundEmail[]
  reminders           FollowUpReminder[]   @relation("ReminderLead")
  sequenceEnrollments SequenceEnrollment[] @relation("SequenceEnrollmentLead")
  campaignMembers     CampaignMember[]

  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@index([organizationId, email])
}

model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       Stage[]
  deals        Deal[]

  @@index([organizationId])
}

model Stage {
  id          String   @id @default(cuid())
  pipelineId  String
  name        String
  position    Int
  probability Int      @default(0) // win probability %
  type        String   @default("OPEN") // OPEN | WON | LOST
  createdAt   DateTime @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]
  fromStageHistory StageHistory[] @relation("FromStage")
  toStageHistory   StageHistory[] @relation("ToStage")

  @@unique([pipelineId, position])
}

model Deal {
  id                String    @id @default(cuid())
  organizationId    String
  name              String
  contactId         String?
  companyId         String?
  leadId            String?
  stageId           String
  pipelineId        String
  ownerId           String?
  sourceId          String?
  lostReasonId      String?
  value             Float     @default(0)
  currency          String    @default("USD")
  status            String    @default("OPEN") // OPEN | WON | LOST
  probability       Int       @default(0)
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  wonAt             DateTime?
  lostAt            DateTime?
  lostReason        String    @default("")
  nextStep          String    @default("")
  summary           String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation("DealContact", fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  stage        Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  owner        User?        @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  source       LeadSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  lostReasonRef LostReason?  @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)
  stageHistory StageHistory[]
  activities   Activity[]
  notes        Note[]
  lead         Lead?        @relation("DealLead", fields: [leadId], references: [id], onDelete: SetNull)
  quotations     Quotation[]     @relation("QuotationDeal")
  salesOrders    SalesOrder[]    @relation("SalesOrderDeal")
  sentEmails   SentEmail[]  @relation("SentEmailDeal")
  lineItems    DealLineItem[]
  campaignMembers     CampaignMember[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@index([stageId])
  @@index([ownerId])
}

model Task {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  description    String    @default("")
  type           String    @default("TODO") // CALL | MEETING | FOLLOW_UP | EMAIL | TODO
  priority       String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status         String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | SKIPPED
  dueAt          DateTime?
  reminderAt     DateTime?
  completedAt    DateTime?
  relatedType    String? // contact | company | lead | deal
  relatedId      String?
  createdById    String
  assignedUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  activities Activity[]
  notes      Note[]
  reminders  FollowUpReminder[] @relation("ReminderTask")

  @@index([organizationId, status])
  @@index([organizationId, assignedUserId, status])
  @@index([organizationId, dueAt])
}

model Activity {
  id              String   @id @default(cuid())
  organizationId  String
  type            String // CALL | EMAIL | MEETING | NOTE | CREATED | UPDATED | STAGE_CHANGE | DEAL_WON | DEAL_LOST | CONVERTED | TASK_COMPLETED | LOGIN
  title           String
  description     String   @default("")
  contactId       String?
  companyId       String?
  dealId          String?
  leadId          String?
  taskId          String?
  userId          String
  durationMinutes Int?
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([contactId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([dealId, occurredAt])
  @@index([leadId, occurredAt])
}

model Note {
  id             String   @id @default(cuid())
  organizationId String
  body           String
  contactId      String?
  companyId      String?
  dealId         String?
  leadId         String?
  taskId         String?
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@index([leadId])
}


model Attachment {
  id          String   @id @default(cuid())
  filename    String   // name stored on disk
  originalName String  // original file name as uploaded
  mimeType    String
  size        Int      // bytes
  path        String   // relative storage path, e.g. uploads/{orgId}/{uuid}-{name}
  storageType String   // LOCAL | S3
  organizationId String
  entityType  String   // CONTACT | COMPANY | LEAD | DEAL | ACTIVITY | NOTE | EMAIL
  entityId    String
  uploadedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?  // soft delete

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([uploadedById])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String // e.g. LOGIN, LOGIN_FAILED, CONTACT_CREATE, DEAL_DELETE
  entityType     String   @default("")
  entityId       String   @default("")
  ipAddress      String   @default("")
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String   @default("")
  type           String   @default("INFO") // INFO | WARNING | SUCCESS | TASK | DEAL
  link           String   @default("")
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model EmailTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  subject        String
  body           String
  category       String   @default("GENERAL")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sentEmails   SentEmail[]  @relation("SentEmailTemplate")

  @@index([organizationId])
}

model CustomField {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String // contact | company | lead | deal
  name           String
  dataType       String   @default("TEXT") // TEXT | NUMBER | DATE | BOOLEAN
  options        String   @default("[]") // JSON array for select-type values
  isRequired     Boolean  @default(false)
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       CustomFieldValue[]

  @@index([organizationId, entityType])
}

model CustomFieldValue {
  id             String   @id @default(cuid())
  fieldId        String
  entityId       String
  value          String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entityId])
}

model EmailSettings {
  id                   String  @id @default(cuid())
  organizationId       String  @unique
  smtpHost             String  @default("")
  smtpPort             Int     @default(587)
  smtpUser             String  @default("")
  smtpPasswordEncrypted String  @default("")
  fromAddress          String  @default("")
  notificationsEnabled Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SentEmail {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  subject        String
  body           String
  recipientEmail String
  recipientName  String    @default("")
  messageId      String    @default("")
  contactId      String?
  leadId         String?
  dealId         String?
  templateId     String?
  status         String    @default("QUEUED") // QUEUED | SENT | FAILED
  error          String    @default("")
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User           @relation("SentEmailSender", fields: [userId], references: [id], onDelete: Cascade)
  contact       Contact?       @relation("SentEmailContact", fields: [contactId], references: [id], onDelete: SetNull)
  lead          Lead?          @relation("SentEmailLead", fields: [leadId], references: [id], onDelete: SetNull)
  deal          Deal?          @relation("SentEmailDeal", fields: [dealId], references: [id], onDelete: SetNull)
  template      EmailTemplate? @relation("SentEmailTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  inboundEmails InboundEmail[] @relation("InboundEmailThread")

  @@index([organizationId, createdAt])
  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
  @@index([userId, createdAt])
}

model FollowUpReminder {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  dedupeKey      String
  kind           String // LEAD_FOLLOW_UP | TASK_DUE | TASK_OVERDUE
  title          String
  body           String   @default("")
  link           String   @default("")
  leadId         String?
  taskId         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("ReminderRecipient", fields: [userId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation("ReminderLead", fields: [leadId], references: [id], onDelete: Cascade)
  task         Task?        @relation("ReminderTask", fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, createdAt])
}

model InboundEmail {
  id             String   @id @default(cuid())
  organizationId String
  fromEmail      String
  fromName       String   @default("")
  subject        String   @default("")
  body           String   @default("")
  messageId      String
  inReplyTo      String   @default("")
  sentEmailId    String?
  contactId      String?
  leadId         String?
  status         String   @default("UNREAD") // UNREAD | READ | IGNORED
  receivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sentEmail    SentEmail?   @relation("InboundEmailThread", fields: [sentEmailId], references: [id], onDelete: SetNull)

  @@unique([organizationId, messageId])
  @@index([organizationId, receivedAt])
  @@index([contactId])
  @@index([leadId])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyHash        String    @unique
  prefix         String
  createdById    String
  lastUsedAt     DateTime?
  isActive       Boolean   @default(true)
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId, prefix])
}

model Sequence {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String   @default("")
  isActive       Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("SequenceCreator", fields: [createdById], references: [id], onDelete: Cascade)
  steps        SequenceStep[]
  enrollments  SequenceEnrollment[]

  @@index([organizationId])
}

model SequenceStep {
  id              String   @id @default(cuid())
  sequenceId      String
  position        Int
  delayHours      Int      @default(24)
  subjectTemplate String
  bodyTemplate    String
  createdAt       DateTime @default(now())

  sequence    Sequence                 @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  enrollments SequenceStepEnrollment[]

  @@unique([sequenceId, position])
  @@index([sequenceId])
}

model SequenceEnrollment {
  id              String    @id @default(cuid())
  organizationId  String
  sequenceId      String
  contactId       String?
  leadId          String?
  enrolledEmail   String
  currentStep     Int       @default(0) // index of the NEXT step to send
  nextSendAt      DateTime?
  status          String    @default("ACTIVE") // ACTIVE | COMPLETED | STOPPED | UNSUBSCRIBED
  stoppedReason   String    @default("")
  responderUserId String?
  unsubToken      String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sequence     Sequence                 @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?                 @relation("SequenceEnrollmentContact", fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?                    @relation("SequenceEnrollmentLead", fields: [leadId], references: [id], onDelete: SetNull)
  responder    User?                    @relation("SequenceEnrollmentResponder", fields: [responderUserId], references: [id], onDelete: SetNull)
  steps        SequenceStepEnrollment[]
  deadLetters  SequenceDeadLetter[]

  @@unique([sequenceId, contactId])
  @@unique([sequenceId, leadId])
  @@index([organizationId, status, nextSendAt])
  @@index([sequenceId])
  @@index([contactId])
  @@index([leadId])
}

model SequenceStepEnrollment {
  id           String @id @default(cuid())
  stepId       String
  enrollmentId String

  step       SequenceStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  enrollment SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([stepId, enrollmentId])
  @@index([enrollmentId])
}


model SequenceDeadLetter {
  id             String   @id @default(cuid())
  organizationId String
  sequenceId     String
  enrollmentId   String
  contactId      String?
  leadId         String?
  stepId         String
  stepPosition   Int
  attempts       Int      @default(0)
  lastError      String   @default("")
  createdAt      DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollment   SequenceEnrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([enrollmentId])
}

model StageHistory {
  id                    String    @id @default(cuid())
  dealId                String
  fromStageId           String?
  toStageId             String
  userId                String
  at                    DateTime  @default(now())
  wonAtSnapshot         DateTime?
  lostAtSnapshot        DateTime?
  actualCloseDateSnapshot DateTime?

  deal       Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage  Stage? @relation("FromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage    Stage  @relation("ToStage", fields: [toStageId], references: [id], onDelete: Restrict)
  user       User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([dealId, at])
  @@index([userId])
}

model LostReason {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String   @default("")
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@unique([organizationId, name])
}

// Quotations and Sales Orders

model Product {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String   @default("")
  sku            String?
  unitPrice      Float
  currency       String   @default("USD")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization          Organization        @relation("ProductOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  priceListItems        PriceListItem[]
  dealLineItems         DealLineItem[]
  quotationLineItems    QuotationLineItem[] @relation("ProductQuotationLineItems")
  salesOrderLineItems   SalesOrderLineItem[] @relation("ProductSalesOrderLineItems")

  @@unique([organizationId, sku])
  @@index([organizationId, isActive])
  @@index([organizationId, name])
}

model PriceList {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String   @default("")
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items           PriceListItem[]

  @@index([organizationId])
  @@index([organizationId, isDefault])
}

model PriceListItem {
  id          String   @id @default(cuid())
  priceListId String
  productId   String
  price       Float
  currency    String   @default("USD")
  createdAt   DateTime @default(now())

  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@index([priceListId])
  @@index([productId])
}

model DealLineItem {
  id          String   @id @default(cuid())
  dealId      String
  productId   String?
  name        String
  description String   @default("")
  quantity    Float  @default(1)
  unitPrice   Float
  total       Float
  createdAt   DateTime @default(now())

  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([productId])
}

model Quotation {
  id          String   @id @default(cuid())
  organizationId String
  quotationNumber String
  dealId      String?
  contactId   String?
  companyId   String?
  status      String   @default("DRAFT") // DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED
  validUntil  DateTime?
  subtotal    Float    @default(0)
  tax         Float    @default(0)
  total       Float    @default(0)
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation("QuotationOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  deal        Deal?       @relation("QuotationDeal", fields: [dealId], references: [id], onDelete: SetNull)
  contact     Contact?    @relation("QuotationContact", fields: [contactId], references: [id], onDelete: SetNull)
  company     Company?    @relation("QuotationCompany", fields: [companyId], references: [id], onDelete: SetNull)
  lineItems   QuotationLineItem[] @relation("QuotationLineItems")
  salesOrders SalesOrder[] @relation("SalesOrderQuotation")

  @@index([organizationId])
  @@index([dealId])
  @@index([quotationNumber])
}

model QuotationLineItem {
  id          String   @id @default(cuid())
  quotationId String
  productId   String?
  name        String
  description String   @default("")
  quantity    Float    @default(1)
  unitPrice   Float
  total       Float
  createdAt   DateTime @default(now())

  quotation Quotation @relation("QuotationLineItems", fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation("ProductQuotationLineItems", fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
}

model SalesOrder {
  id           String   @id @default(cuid())
  organizationId String
  orderNumber  String
  quotationId  String?
  dealId       String?
  contactId    String?
  companyId    String?
  status       String   @default("PENDING") // PENDING | CONFIRMED | COMPLETED | CANCELLED
  orderDate    DateTime @default(now())
  subtotal     Float    @default(0)
  tax          Float    @default(0)
  total        Float    @default(0)
  shippingAddress String @default("")
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization  @relation("SalesOrderOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation?    @relation("SalesOrderQuotation", fields: [quotationId], references: [id], onDelete: SetNull)
  deal         Deal?         @relation("SalesOrderDeal", fields: [dealId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation("SalesOrderContact", fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?      @relation("SalesOrderCompany", fields: [companyId], references: [id], onDelete: SetNull)
  lineItems    SalesOrderLineItem[] @relation("SalesOrderLineItems")

  @@index([organizationId])
  @@index([quotationId])
  @@index([orderNumber])
}

model SalesOrderLineItem {
  id           String   @id @default(cuid())
  salesOrderId String
  productId    String?
  name         String
  description  String   @default("")
  quantity     Float    @default(1)
  unitPrice    Float
  total        Float
  createdAt    DateTime @default(now())

  salesOrder SalesOrder @relation("SalesOrderLineItems", fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product?   @relation("ProductSalesOrderLineItems", fields: [productId], references: [id], onDelete: SetNull)

  @@index([salesOrderId])
}

// Campaign: marketing/sales campaign tracking
model Campaign {
  id            String   @id @default(cuid())
  organizationId String
  name          String
  description   String   @default("")
  startDate     DateTime?
  endDate       DateTime?
  status        String   @default("PLANNING") // PLANNING | ACTIVE | COMPLETED | ON_HOLD
  budget        Float    @default(0)
  cost          Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      CampaignMember[]

  @@index([organizationId])
  @@index([status])
}

// CampaignMember: links leads/contacts/deals to campaigns with engagement status
model CampaignMember {
  id          String   @id @default(cuid())
  campaignId  String
  leadId      String?
  contactId   String?
  dealId      String?
  status      String   @default("ADDED") // ADDED | ENGAGED | CONVERTED | LOST
  createdAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal     Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([leadId])
  @@index([contactId])
  @@index([dealId])
  @@unique([campaignId, leadId])
  @@unique([campaignId, contactId])
  @@unique([campaignId, dealId])
}
