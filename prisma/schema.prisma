// CRM database schema. SQLite today; written to be PostgreSQL-compatible.
// No enums (string fields + Zod validation), no arrays (join tables).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  industry  String   @default("")
  website   String   @default("")
  phone     String   @default("")
  address   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  companies           Company[]
  contacts            Contact[]
  leads               Lead[]
  pipelines           Pipeline[]
  deals               Deal[]
  tasks               Task[]
  activities          Activity[]
  notes               Note[]
  notifications       Notification[]
  tags                Tag[]
  leadSources         LeadSource[]
  lostReasons         LostReason[]
  emailTemplates      EmailTemplate[]
  customFields        CustomField[]
  emailSettings       EmailSettings?
  sentEmails          SentEmail[]
  inboundEmails       InboundEmail[]
  reminders           FollowUpReminder[]
  sequenceDeadLetters SequenceDeadLetter[]
  apiKeys             ApiKey[]
  sequences           Sequence[]
  sequenceEnrollments SequenceEnrollment[]
  currency            String               @default("USD")
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  name           String
  passwordHash   String
  role           String    @default("SALES_REP") // ADMIN | MANAGER | SALES_REP
  title          String    @default("")
  phone          String    @default("")
  avatarColor    String    @default("#6366f1")
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions            Session[]
  ownedCompanies      Company[]            @relation("CompanyOwner")
  ownedContacts       Contact[]            @relation("ContactOwner")
  ownedLeads          Lead[]               @relation("LeadOwner")
  assignedLeads       Lead[]               @relation("LeadAssignee")
  ownedDeals          Deal[]               @relation("DealOwner")
  tasks               Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  activities          Activity[]
  notes               Note[]
  notifications       Notification[]
  sentEmails          SentEmail[]          @relation("SentEmailSender")
  reminders           FollowUpReminder[]   @relation("ReminderRecipient")
  createdApiKeys      ApiKey[]             @relation("ApiKeyCreator")
  createdSequences    Sequence[]           @relation("SequenceCreator")
  sequenceEnrollments SequenceEnrollment[] @relation("SequenceEnrollmentResponder")
  stageHistory        StageHistory[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  domain         String    @default("")
  industry       String    @default("")
  size           String    @default("")
  phone          String    @default("")
  website        String    @default("")
  address        String    @default("")
  city           String    @default("")
  state          String    @default("")
  country        String    @default("")
  ownerId        String?
  summary        String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     Contact[]
  leads        Lead[]
  deals        Deal[]
  activities   Activity[]
  notes        Note[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, name])
}

model Contact {
  id              String    @id @default(cuid())
  organizationId  String
  companyId       String?
  firstName       String
  lastName        String
  email           String
  phone           String    @default("")
  mobile          String    @default("")
  title           String    @default("")
  address         String    @default("")
  city            String    @default("")
  state           String    @default("")
  country         String    @default("")
  ownerId         String?
  status          String    @default("ACTIVE") // LEAD | ACTIVE | CUSTOMER | INACTIVE | CHURNED
  avatarColor     String    @default("#6366f1")
  // Free-text summary; the merge feature prefixes it with the survivor
  // merge, mirroring the Lead.summary convention.
  summary         String    @default("")
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner               User?                @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  leads               Lead[]
  activities          Activity[]
  notes               Note[]
  deals               Deal[]               @relation("DealContact")
  sentEmails          SentEmail[]          @relation("SentEmailContact")
  inboundEmails       InboundEmail[]
  sequenceEnrollments SequenceEnrollment[] @relation("SequenceEnrollmentContact")

  tags Tag[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, email])
  @@index([organizationId, companyId])
  @@index([organizationId, createdAt])
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#6366f1")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]

  @@unique([organizationId, name])
}

model LeadSource {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]
  deals        Deal[]

  organizationId String

  @@unique([organizationId, name])
}

model Lead {
  id                String    @id @default(cuid())
  organizationId    String
  firstName         String
  lastName          String
  email             String
  phone             String    @default("")
  companyName       String    @default("")
  companyId         String?
  sourceId          String?
  status            String    @default("NEW") // NEW | CONTACTED | QUALIFIED | UNQUALIFIED | CONVERTED
  score             Int       @default(0)
  estimatedValue    Float     @default(0)
  expectedCloseDate DateTime?
  followUpAt        DateTime?
  summary           String    @default("")
  contactId         String?
  assignedUserId    String?
  ownerId           String?
  convertedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  source              LeadSource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  contact             Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedUser        User?                @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  owner               User?                @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities          Activity[]
  notes               Note[]
  deals               Deal[]               @relation("DealLead")
  sentEmails          SentEmail[]          @relation("SentEmailLead")
  inboundEmails       InboundEmail[]
  reminders           FollowUpReminder[]   @relation("ReminderLead")
  sequenceEnrollments SequenceEnrollment[] @relation("SequenceEnrollmentLead")

  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@index([organizationId, email])
}

model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       Stage[]
  deals        Deal[]

  @@index([organizationId])
}

model Stage {
  id          String   @id @default(cuid())
  pipelineId  String
  name        String
  position    Int
  probability Int      @default(0) // win probability %
  type        String   @default("OPEN") // OPEN | WON | LOST
  createdAt   DateTime @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]
  stageHistoryFrom StageHistory[] @relation("StageHistoryFrom")
  stageHistoryTo   StageHistory[] @relation("StageHistoryTo")

  @@unique([pipelineId, position])
}

model StageHistory {
  id                       String   @id @default(cuid())
  dealId                   String
  fromStageId              String?
  toStageId                String
  userId                   String
  at                       DateTime @default(now())
  wonAtSnapshot            DateTime?
  lostAtSnapshot           DateTime?
  actualCloseDateSnapshot  DateTime?

  deal      Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage Stage? @relation("StageHistoryFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage   Stage  @relation("StageHistoryTo", fields: [toStageId], references: [id], onDelete: Restrict)
  user      User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([dealId, at])
  @@index([userId])
}



model LostReason {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String   @default("")
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@unique([organizationId, name])
}

model Deal {
  id                      String    @id @default(cuid())
  organizationId          String
  name                    String
  contactId               String?
  companyId               String?
  leadId                  String?
  stageId                 String
  pipelineId              String
  ownerId                 String?
  sourceId                String?
  lostReasonId            String?
  value                   Float     @default(0)
  currency                String    @default("USD")
  status                  String    @default("OPEN") // OPEN | WON | LOST
  probability             Int       @default(0)
  expectedCloseDate       DateTime?
  actualCloseDate         DateTime?
  wonAt                   DateTime?
  lostAt                  DateTime?
  lostReason              String    @default("")
  nextStep                String    @default("")
  summary                 String    @default("")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation("DealContact", fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  stage        Stage       @relation(fields: [stageId], references: [id], onDelete: Restrict)
  pipeline     Pipeline    @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  owner        User?       @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  source       LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  lostReasonRel LostReason? @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)
  activities   Activity[]
  notes        Note[]
  lead         Lead?       @relation("DealLead", fields: [leadId], references: [id], onDelete: SetNull)
  sentEmails   SentEmail[] @relation("SentEmailDeal")
  stageHistory StageHistory[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@index([stageId])
  @@index([ownerId])
  @@index([lostReasonId])
}

model Task {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  description    String    @default("")
  type           String    @default("TODO") // CALL | MEETING | FOLLOW_UP | EMAIL | TODO
  priority       String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status         String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | SKIPPED
  dueAt          DateTime?
  reminderAt     DateTime?
  completedAt    DateTime?
  relatedType    String? // contact | company | lead | deal
  relatedId      String?
  createdById    String
  assignedUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  activities Activity[]
  notes      Note[]
  reminders  FollowUpReminder[] @relation("ReminderTask")

  @@index([organizationId, status])
  @@index([organizationId, assignedUserId, status])
  @@index([organizationId, dueAt])
}

model Activity {
  id              String   @id @default(cuid())
  organizationId  String
  type            String // CALL | EMAIL | MEETING | NOTE | CREATED | UPDATED | STAGE_CHANGE | DEAL_WON | DEAL_LOST | CONVERTED | TASK_COMPLETED | LOGIN
  title           String
  description     String   @default("")
  contactId       String?
  companyId       String?
  dealId          String?
  leadId          String?
  taskId          String?
  userId          String
  durationMinutes Int?
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([contactId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([dealId, occurredAt])
  @@index([leadId, occurredAt])
}

model Note {
  id             String   @id @default(cuid())
  organizationId String
  body           String
  contactId      String?
  companyId      String?
  dealId         String?
  leadId         String?
  taskId         String?
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@index([leadId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String // e.g. LOGIN, LOGIN_FAILED, CONTACT_CREATE, DEAL_DELETE
  entityType     String   @default("")
  entityId       String   @default("")
  ipAddress      String   @default("")
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String   @default("")
  type           String   @default("INFO") // INFO | WARNING | SUCCESS | TASK | DEAL
  link           String   @default("")
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model EmailTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  subject        String
  body           String
  category       String   @default("GENERAL")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sentEmails   SentEmail[]  @relation("SentEmailTemplate")

  @@index([organizationId])
}

model CustomField {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String // contact | company | lead | deal
  name           String
  dataType       String   @default("TEXT") // TEXT | NUMBER | DATE | BOOLEAN
  options        String   @default("[]") // JSON array for select-type values
  isRequired     Boolean  @default(false)
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       CustomFieldValue[]

  @@index([organizationId, entityType])
}

model CustomFieldValue {
  id             String   @id @default(cuid())
  fieldId        String
  entityId       String
  value          String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entityId])
}

model EmailSettings {
  id                   String  @id @default(cuid())
  organizationId       String  @unique
  smtpHost             String  @default("")
  smtpPort             Int     @default(587)
  smtpUser             String  @default("")
  smtpPasswordEncrypted String  @default("")
  fromAddress          String  @default("")
  notificationsEnabled Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// A single outbound email sent from the CRM, with delivery status. Recipient
// email is snapshotted so history survives contact email changes/deletes.
model SentEmail {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  subject        String
  body           String
  recipientEmail String
  recipientName  String    @default("")
  messageId      String    @default("")
  contactId      String?
  leadId         String?
  dealId         String?
  templateId     String?
  status         String    @default("QUEUED") // QUEUED | SENT | FAILED
  error          String    @default("")
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User           @relation("SentEmailSender", fields: [userId], references: [id], onDelete: Cascade)
  contact       Contact?       @relation("SentEmailContact", fields: [contactId], references: [id], onDelete: SetNull)
  lead          Lead?          @relation("SentEmailLead", fields: [leadId], references: [id], onDelete: SetNull)
  deal          Deal?          @relation("SentEmailDeal", fields: [dealId], references: [id], onDelete: SetNull)
  template      EmailTemplate? @relation("SentEmailTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  inboundEmails InboundEmail[] @relation("InboundEmailThread")

  @@index([organizationId, createdAt])
  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
  @@index([userId, createdAt])
}

// A scheduled reminder generated for a due lead follow-up or an
// overdue/reminder-due task. Deduplicated by a stable key so the scheduler
// can run repeatedly without spamming the same reminder twice.
model FollowUpReminder {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  dedupeKey      String
  kind           String // LEAD_FOLLOW_UP | TASK_DUE | TASK_OVERDUE
  title          String
  body           String   @default("")
  link           String   @default("")
  leadId         String?
  taskId         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("ReminderRecipient", fields: [userId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation("ReminderLead", fields: [leadId], references: [id], onDelete: Cascade)
  task         Task?        @relation("ReminderTask", fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, createdAt])
}

// An inbound email received in the shared IMAP inbox and matched to CRM
// records. "Matched" means the reply belongs to a known thread (In-Reply-To
// points at a SentEmail), the sender is an open lead, or the sender is a
// known contact. Unmatched mail is never stored.
model InboundEmail {
  id             String   @id @default(cuid())
  organizationId String
  fromEmail      String
  fromName       String   @default("")
  subject        String   @default("")
  body           String   @default("")
  messageId      String
  inReplyTo      String   @default("")
  sentEmailId    String?
  contactId      String?
  leadId         String?
  status         String   @default("UNREAD") // UNREAD | READ | IGNORED
  receivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sentEmail    SentEmail?   @relation("InboundEmailThread", fields: [sentEmailId], references: [id], onDelete: SetNull)

  @@unique([organizationId, messageId])
  @@index([organizationId, receivedAt])
  @@index([contactId])
  @@index([leadId])
}

// A public lead-capture API key. Only the SHA-256 hash of the full key is
// stored; the prefix (first 8 chars, e.g. "lc_a1b2c") supports display and
// index-friendly lookup before a constant-time hash comparison. Revocation
// is soft (isActive=false + revokedAt) to preserve the audit trail.
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyHash        String    @unique
  prefix         String
  createdById    String
  lastUsedAt     DateTime?
  isActive       Boolean   @default(true)
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId, prefix])
}

// An automated follow-up sequence: an ordered list of email steps that get
// rendered and sent to enrolled records by the sequence scheduler.
model Sequence {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String   @default("")
  isActive       Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("SequenceCreator", fields: [createdById], references: [id], onDelete: Cascade)
  steps        SequenceStep[]
  enrollments  SequenceEnrollment[]

  @@index([organizationId])
}

// One email step inside a sequence. `delayHours` is the wait after the
// PREVIOUS step (step 0's delay is measured from enrollment), so a scan
// schedules nextSendAt = lastEvent + delayHours.
model SequenceStep {
  id              String   @id @default(cuid())
  sequenceId      String
  position        Int
  delayHours      Int      @default(24)
  subjectTemplate String
  bodyTemplate    String
  createdAt       DateTime @default(now())

  sequence    Sequence                 @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  enrollments SequenceStepEnrollment[]

  @@unique([sequenceId, position])
  @@index([sequenceId])
}

// Enrollment of one record (contact or lead) in a sequence. `enrolledEmail`
// is a snapshot so sequence history survives later record edits. The DB
// unique on (sequenceId, contactId) / (sequenceId, leadId) is a SAFETY NET
// only: the active-only rule "one active enrollment per record per
// sequence" is enforced in code, so re-enrollment after COMPLETED/STOPPED is
// allowed and raising a P2002 here means an ACTIVE enrollment already
// exists → the route maps it to 409 ALREADY_ENROLLED.
model SequenceEnrollment {
  id              String    @id @default(cuid())
  organizationId  String
  sequenceId      String
  contactId       String?
  leadId          String?
  enrolledEmail   String
  currentStep     Int       @default(0) // index of the NEXT step to send
  nextSendAt      DateTime?
  status          String    @default("ACTIVE") // ACTIVE | COMPLETED | STOPPED | UNSUBSCRIBED
  stoppedReason   String    @default("")
  responderUserId String? // who enrolled the record
  unsubToken      String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sequence     Sequence                 @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?                 @relation("SequenceEnrollmentContact", fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?                    @relation("SequenceEnrollmentLead", fields: [leadId], references: [id], onDelete: SetNull)
  responder    User?                    @relation("SequenceEnrollmentResponder", fields: [responderUserId], references: [id], onDelete: SetNull)
  steps        SequenceStepEnrollment[]
  deadLetters    SequenceDeadLetter[]

  @@unique([sequenceId, contactId])
  @@unique([sequenceId, leadId])
  @@index([organizationId, status, nextSendAt])
  @@index([sequenceId])
  @@index([contactId])
  @@index([leadId])
}

// Join row: which step an enrollment is parked at, carried on the step so
// step deletion can be detected (enrollment referencing a missing step is
// stopped with stoppedReason "step missing").
model SequenceStepEnrollment {
  id           String @id @default(cuid())
  stepId       String
  enrollmentId String

  step       SequenceStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  enrollment SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([stepId, enrollmentId])
  @@index([enrollmentId])
}


// Dead-letter record for a sequence step that failed every send retry.
// Operators inspect these to diagnose broken sends (SMTP, DNS, bounces, ...)
// and re-enroll the record once the underlying issue is fixed.
model SequenceDeadLetter {
  id            String   @id @default(cuid())
  organizationId String
  sequenceId    String
  enrollmentId  String
  contactId     String?
  leadId        String?
  stepId        String
  stepPosition  Int
  attempts      Int      @default(0)
  lastError     String   @default("")
  createdAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollment   SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([enrollmentId])
}

