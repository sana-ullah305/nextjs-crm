# Local development environment
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"

# Encryption key for sensitive fields (generate one with: openssl rand -hex 32)
ENCRYPTION_KEY=

# Directory for local attachment uploads (relative to project root)
UPLOAD_DIR="uploads"

# Service token for unattended scheduler/cron calls to /api/*/run routes.
# Callers pass it as: Authorization: Bearer $SCHEDULER_SECRET
SCHEDULER_SECRET=""
