# ---------------------------------------------------------------------------
# Environment configuration (copy to .env and adjust).
# ---------------------------------------------------------------------------

# PostgreSQL connection string (REQUIRED).
# The CRM uses PostgreSQL via Prisma. Provision a database first, e.g.:
#   createdb crm
#   # or with Docker:
#   docker run --name crm-postgres -e POSTGRES_PASSWORD=password \
#     -e POSTGRES_DB=crm -p 5432:5432 -d postgres:16
# Then point DATABASE_URL at it and run `npm run db:migrate` (or `db:push`).
# Format: postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL="postgresql://user:password@localhost:5432/crm"

# Public base URL of the app (used for links in emails, etc.).
APP_URL="http://localhost:3000"

# Service token for unattended scheduler/cron calls to /api/*/run routes.
# Callers pass it as: Authorization: Bearer $SCHEDULER_SECRET
# Generate one with: openssl rand -hex 32
SCHEDULER_SECRET="change-me-to-a-long-random-string"
