# Local development environment
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"

# Service token for unattended scheduler/cron calls to /api/*/run routes.
# Callers pass it as: Authorization: Bearer $SCHEDULER_SECRET
# Generate with: openssl rand -hex 32
SCHEDULER_SECRET=""

# Cron setup for scheduler endpoints (run from crontab or external scheduler):
# Reminders scan (every 15 minutes):
# */15 * * * * curl -H "Authorization: Bearer $SCHEDULER_SECRET" http://localhost:3000/api/reminders/run
#
# Sequences scan (every 15 minutes):
# */15 * * * * curl -H "Authorization: Bearer $SCHEDULER_SECRET" http://localhost:3000/api/sequences/run
#
# Inbound mail scan (every 5 minutes):
# */5 * * * * curl -H "Authorization: Bearer $SCHEDULER_SECRET" http://localhost:3000/api/inbound/run
