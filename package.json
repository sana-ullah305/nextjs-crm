{
  "name": "nextjs-crm",
  "version": "0.1.0",
  "description": "Open-source CRM built with Next.js: auth, RBAC, email outreach, follow-up sequences, lead capture, and global search.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sana-ullah305/nextjs-crm.git"
  },
  "bugs": {
    "url": "https://github.com/sana-ullah305/nextjs-crm/issues"
  },
  "homepage": "https://github.com/sana-ullah305/nextjs-crm#readme",
  "keywords": [
    "crm",
    "nextjs",
    "typescript",
    "prisma",
    "tailwindcss",
    "sales-pipeline",
    "self-hosted"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
