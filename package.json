    "@radix-ui/react-slot": "^1.5.0",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "imapflow": "^2.11.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.21.0",
    "prisma": "7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
